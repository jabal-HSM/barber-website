# ZEYD BARBER — secrets of the Supabase Edge Functions (create-checkout, stripe-webhook)
#
# 1. Copy this file to  supabase/functions/.env  (same folder, name ".env").
#    That file is ignored by Git: never commit it, never paste its content in the website.
# 2. Fill in the values after the "=" sign (no spaces, no quotes).
# 3. Send them to Supabase:  npx supabase secrets set --env-file supabase/functions/.env
#    (or Dashboard → Edge Functions → Secrets, one by one).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# --- Telegram (message to Hashem after each confirmed real payment) ---
# Token given by @BotFather, e.g. 1234567890:AAH...   ← put it right after the "="
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=8705155832
# true only to try the message with a Stripe TEST payment; keep false otherwise
TELEGRAM_NOTIFY_TEST_PAYMENTS=false

# --- Telegram to Zeyd (notify-staff: customer cancellations and reschedulings) ---
# Zeyd's own chat id (Zeyd presses Start on the bot, then reads his id, e.g. with @userinfobot).
# Empty = nothing is sent; the cancellation is still shown in the dashboard with « non configuré ».
TELEGRAM_STAFF_CHAT_ID=
# fr or ar
TELEGRAM_STAFF_LANG=fr

# --- Stripe (keys of the mother's Stripe account) ---
# Development: TEST keys only (sk_test_... and the whsec_... of the test webhook endpoint)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stays false until the mother's Stripe account is verified and the owner approves going live
ALLOW_LIVE_PAYMENTS=false

# --- Website ---
# Address of the site, used for the return pages after payment (no trailing slash)
SITE_URL=http://127.0.0.1:5501
# Sites allowed to call create-checkout, comma-separated
ALLOWED_ORIGINS=http://127.0.0.1:5501,http://localhost:5501
